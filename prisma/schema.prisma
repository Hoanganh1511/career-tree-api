// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String       @id @default(uuid())
  googleId          String       @unique
  email             String       @unique
  name              String
  // Dashboard Skill Tree: dung de so sanh benchmark theo nam kinh nghiem
  // (Phase 4) - de null neu nguoi dung chua khai bao.
  yearsOfExperience Int?
  // "Dang xuat khoi moi thiet bi": moi token noi bo co `iat` TRUOC moc nay
  // deu bi tu choi (xem JwtAuthGuard). Session cua Auth.js la JWT stateless
  // (khong co session store) nen day la cach duy nhat thu hoi duoc session
  // ma khong phai doi ca co che session - xem docs/user-schema-design.md.
  tokensValidAfter  DateTime?
  // Danh tinh cong khai cho feed (Post.author) - xem docs/user-schema-design.md
  // muc 4.1/4.2 (Phase 1). Nullable vi user dong bo qua Google sync KHONG co
  // san 3 field nay (Google chi cho googleId/email/name/picture) - UserService
  // tu sinh username tu email luc sync neu con null.
  username          String?      @unique
  avatarUrl         String?
  verified          Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  posts             Post[]
  followerCount     Int          @default(0)
  followingCount    Int          @default(0)
  following         UserFollow[] @relation("Follower")
  followedBy        UserFollow[] @relation("Followee")
  blocksMade        UserBlock[]  @relation("Blocker")
  blockedBy         UserBlock[]  @relation("Blocked")
  profile           UserProfile?

  communitiesOwened            Community[]
  communityMemberships         CommunityMember[]
  communityPosts               CommunityPost[]
  comments                     Comment[]
  reactions                    Reaction[]
  requestedChannels            Channel[]                    @relation("ChannelRequestedBy")
  documents                    Document[]
  workspaces                   Workspace[]
  knowledgeGroupCollaborations KnowledgeGroupCollaborator[]
  notificationsReceived        Notification[]               @relation("NotificationRecipient")
  notificationsActedOn         Notification[]               @relation("NotificationActor")
  conversationParticipations   ConversationParticipant[]
  messagesSent                 Message[]
  pollVotes                    PollVote[]
  messageReactions             MessageReaction[]
}

// Feed Trang chu - truoc day 100% mock o frontend (enggo/src/content/
// home-feed-mock.ts), gio la du lieu that. 1 bang CHUNG cho ca 24 "kind" bai
// dang (dung 1 bang + cot `data: Json` chua field rieng tung loai, giong cach
// Card.content dang lam cho Node) thay vi 24 bang/cot rieng - tranh no schema.
// `kind` luu SCREAMING_SNAKE (dung convention enum cua repo); API tra ve/nhan
// vao dang kebab-case ("skill-report") khop voi frontend Post["kind"] union -
// chuyen doi 2 chieu nam trong post.service.ts (PostModule), KHONG trong DTO.
enum PostKind {
  TEXT
  IMAGE
  GALLERY
  VIDEO
  FILE
  LINK
  RESOURCE
  NOTE
  PROJECT_UPDATE
  ACHIEVEMENT
  MILESTONE
  QUESTION
  POLL
  CAREER_UPDATE
  SKILL_UPDATE
  NODE_CREATED
  KNOWLEDGE_BLOCK
  TIMELINE_EVENT
  CODE_SNIPPET
  IDEA
  TUTORIAL
  EXPERIMENT
  EVENT
  SKILL_REPORT
  WORKSPACE_POST
}

enum FollowStatus {
  ACTIVE
  PENDING
}

// "Topic" cua bai dang (vd Frontend/Backend/LLM/...) - khop 1-1 voi danh sach
// topic trong enggo/src/lib/discover/knowledge-worlds.ts (slug kebab-case ben
// frontend -> UPPER_SNAKE_CASE o day, vd "ai-agents" -> AI_AGENTS). Day la
// TANG LOC DUOC (co index), khac "topic" trong `data` JSON (tu do, chi de
// hien thi breadcrumb, khong index duoc - ten trung nhau nhung 2 khai niem
// khac nhau).
//
// GAME_DEV/IOT/DEV_TOOLS/DATA_AI/UI_UX/CAREER/SOFT_SKILLS/QA_TEST/SECURITY la
// gia tri CU tu taxonomy nghe nghiep truoc day (category-taxonomy.ts, da xoa)
// - GIU LAI vi da co bai seed gan gia tri nay, khong con duoc UI moi
// (knowledge-worlds.ts) su dung de tao pill/topic nua.
enum PostCategory {
  FRONTEND
  BACKEND
  MOBILE
  GAME_DEV
  BLOCKCHAIN
  IOT
  DEV_TOOLS
  DATA_AI
  DATABASE
  PRODUCT
  UI_UX
  DEVOPS
  CLOUD
  SYSTEM_DESIGN
  SECURITY
  QA_TEST
  CAREER
  SOFT_SKILLS
  // --- Them cho Knowledge World "Think" ---
  ALGORITHMS
  ARCHITECTURE
  PERFORMANCE
  DISTRIBUTED_SYSTEMS
  // --- Them cho Knowledge World "AI" ---
  PROMPT_ENGINEERING
  LLM
  AI_AGENTS
  MCP
  RAG
  COMPUTER_VISION
  // --- Them cho Knowledge World "Create" ---
  UI
  UX
  MOTION
  FIGMA
  DESIGN_SYSTEM
  // --- Them cho Knowledge World "Career" (topic con, khac CAREER cu o tren) ---
  RESUME
  INTERVIEW
  PRODUCTIVITY
  REMOTE
  FREELANCE
  // --- Them cho Knowledge World "Business" ---
  STARTUP
  GROWTH
  MARKETING
}

// Phan loai bai dang theo LINH VUC NGHE NGHIEP - 2 tang (nhom cha -> nhanh
// con), khac voi `PostCategory` (enum) - truc "topic" cua Knowledge Worlds
// (FRONTEND/LLM/...). 1 post co the mang CA HAI phan loai (vd
// topic=PERFORMANCE + nghe nghiep="Lap trinh web/mobile") nen phai la 2 cot
// rieng, khong gop.
//
// Danh sach nhom/nhanh dinh nghia san qua seed (prisma/seed-posts.ts), user
// KHONG tu tao duoc.
model CareerCategoryGroup {
  id         String           @id @default(uuid())
  slug       String           @unique
  name       String
  icon       String? // slug lucide, tuy chon
  // CHI dung lam tie-breaker khi 2 nhom bang nhau ve so post 7 ngay - thu tu
  // hien thi that do so post quyet dinh (xem FeedCategoryService).
  orderIndex Int              @default(0)
  categories CareerCategory[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model CareerCategory {
  id         String              @id @default(uuid())
  groupId    String
  group      CareerCategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slug       String              @unique
  name       String
  orderIndex Int                 @default(0)
  posts      Post[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([groupId])
}

// CONTEST = cuoc thi co giai thuong/han chot; TOPIC = chu de viet bai thuong
// truc (khong giai). Ca 2 deu hien thi duoi dang 1 hashtag.
enum ContestKind {
  CONTEST
  TOPIC
}

enum ContestStatus {
  OPEN
  JUDGING
  CLOSED
}

model Contest {
  id            String        @id @default(uuid())
  slug          String        @unique
  hashtag       String        @unique // luu KHONG kem dau #, UI tu them
  title         String
  description   String
  kind          ContestKind
  status        ContestStatus @default(OPEN)
  partnerName   String? // "Asahi Beverages" -> UI hien "voi ..."
  coverImageUrl String?
  accent        String? // hex cho vien the + nen anh bia
  prize         String?
  deadline      DateTime?
  // So tinh san, cung loi voi Post.likesCount - seed cap nhat cho khop so
  // ban ghi PostContest that.
  postCount     Int           @default(0)
  posts         PostContest[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

// Bang noi tuong minh (dung convention nhu UserFollow/UserBlock) - 1 bai co
// the tham gia nhieu contest/chu de cung luc.
model PostContest {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  contestId String
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, contestId])
  @@index([contestId, createdAt])
}

model UserBlock {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockerId])
}

model UserFollow {
  followerId String
  follower   User         @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User         @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  status     FollowStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId, createdAt])
  @@index([followerId, createdAt])
}

model Post {
  id               String          @id @default(uuid())
  authorId         String
  author           User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind             PostKind
  // Linh vuc bai dang thuoc ve (Frontend/Backend/...) - optional vi khong
  // phai kind nao cung can gan (vd poll/idea co the khong chon). Day la cot
  // that, co index, dung de loc o GET /posts?category=... (xem
  // PostController) - KHAC "topic" (van nam trong `data` JSON ben duoi, chi
  // de hien thi, khong dung de loc).
  category         PostCategory?
  // Linh vuc NGHE NGHIEP cua bai (2 tang, xem CareerCategoryGroup) - truc loc
  // DOC LAP voi `category` o tren: `category` la topic Knowledge World, cot
  // nay la nganh nghe. Null = bai "Chia se chung" (khong gan nganh cu the).
  careerCategoryId String?
  careerCategory   CareerCategory? @relation(fields: [careerCategoryId], references: [id], onDelete: SetNull)
  // Field rieng tung kind (content/title/image/poll options/...) - shape khop
  // voi tung nhanh cua Post union o frontend, TRU cac field icon/accent rieng
  // le (achievement/project-update/knowledge-block/tutorial/link/resource) -
  // nhung field do gio lay theo KIND tu POST_KIND_META o frontend thay vi luu
  // rieng tung post, tranh phai serialize component icon (khong the luu DB).
  data             Json
  // So tinh, seed san - CHUA co bang Like/Comment that, bam Like/Comment o UI
  // hien la tuong tac cuc bo (xem ActionButton.tsx), chua ghi lai DB.
  likesCount       Int             @default(0)
  commentsCount    Int             @default(0)
  repostsCount     Int             @default(0)
  contests         PostContest[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([category, createdAt])
  @@index([careerCategoryId, createdAt])
}

model UserProfile {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String?
  coverImageUrl String?
  location      String?
  websiteUrl    String?
  pronouns      String?
  postCount     Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Community {
  id          String            @id @default(uuid())
  slug        String            @unique
  name        String
  description String
  isPublic    Boolean           @default(true)
  memberCount Int               @default(0) //cache, cap nhat khi CommunityMember.status -> APPROVED
  ownerId     String?
  owner       User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  channels    Channel[]
  members     CommunityMember[]
  posts       CommunityPost[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum ChannelGroup {
  KNOWLEDGE
  TOOLS
}

enum ChannelStatus {
  PENDING
  APPROVED
  REJECTED
}

model Channel {
  id             String          @id @default(uuid())
  communityId    String
  community      Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  group          ChannelGroup    @default(KNOWLEDGE)
  description    String
  bannerImageUrl String?
  messageCount   Int             @default(0) //cache
  orderIndex     Int             @default(0)
  // Kenh do OWNER/ADMIN tao -> APPROVED ngay; thanh vien thuong de xuat ->
  // PENDING, cho quan tri duyet (xem ChannelService.create). Danh sach kenh
  // hien thi (findAllForCommunity, CommunityService.findBySlug) CHI lay
  // APPROVED - PENDING/REJECTED khong lo ra ngoai tru cho moderator xem qua
  // channelRequests.
  status         ChannelStatus   @default(PENDING)
  requestedById  String?
  requestedBy    User?           @relation("ChannelRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  posts          CommunityPost[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([communityId, slug])
  @@index([communityId])
  @@index([communityId, status])
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  MENTOR
  MEMBER
}

enum CommunityMemberStatus {
  PENDING
  APPROVED
  REJECTED
}

model CommunityMember {
  id          String                @id @default(uuid())
  communityId String
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CommunityMemberRole   @default(MEMBER)
  status      CommunityMemberStatus @default(PENDING)
  points      Int                   @default(0) // diem hoat dong, hien "X diem" o activeMembers
  joinReason  String? // ly do xin tham gia, ung voi CommunityJoinRequestDetailed.reason
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([communityId, userId])
  @@index([communityId, status])
  @@index([userId])
}

enum CommunityPostCategory {
  LEARNING
  QUESTION
  RESOURCE
}

model CommunityPost {
  id            String                 @id @default(uuid())
  communityId   String
  community     Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  channelId     String
  channel       Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      CommunityPostCategory?
  title         String?
  content       String
  data          Json?
  isPinned      Boolean                @default(false)
  likesCount    Int                    @default(0)
  commentsCount Int                    @default(0)
  comments      Comment[]
  reactions     Reaction[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([channelId, createdAt])
  @@index([communityId, createdAt])
  @@index([authorId])
}

model Comment {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?      @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentToComment")
  content   String
  reactions Reaction[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model Reaction {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  postId    String?
  post      CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, postId, emoji])
  @@unique([userId, commentId, emoji])
  @@index([postId])
  @@index([commentId])
}

// Workspace - vung kien thuc top-level do CHINH nguoi dung tu dat ten (vd
// "Hoc tap", "Film"), KHONG phai enum co dinh. Chi CHU SO HUU tao/xoa/sua
// Workspace; cong tac (collaboration) chi xay ra o tang KnowledgeGroup ben
// duoi, khong o tang nay. Hien trong tab "Workspace" cua profile
// (/u/[username]/workspaces), thay cho tab "Tài liệu" (docs) cu.
model Workspace {
  id          String           @id @default(uuid())
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  icon        String? // slug icon, tuy chon
  color       String? // hex accent, tuy chon
  orderIndex  Int              @default(0)
  groups      KnowledgeGroup[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([ownerId, orderIndex])
}

enum KnowledgeGroupVisibility {
  PUBLIC
  PRIVATE
}

// Nhom kien thuc - tang phan cap giua Workspace va Document. `visibility`
// CHI gate quyen XEM cho nguoi khong phai collaborator (PUBLIC = ai cung xem
// duoc bai da publish trong nhom; PRIVATE = chi chu + collaborator da duoc
// duyet). Quyen GHI (tao/sua bai) LUON LA chu so huu + collaborator
// APPROVED, BAT KE visibility - PUBLIC khong co nghia la "ai cung viet duoc",
// chi la "ai cung xem duoc".
model KnowledgeGroup {
  id            String                       @id @default(uuid())
  workspaceId   String
  workspace     Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  // Ten export cua 1 icon lucide-react (vd "BookOpen") - FE chon qua
  // GroupIconPicker.tsx tu 1 danh sach curated (khong phai raw emoji glyph
  // nhu Workspace.icon), null = dung icon fallback (Folder) o FE.
  icon          String?
  // "Muc tieu" cua nhom - Tiptap JSON, schema HAN CHE giong Document.overview
  // (chi bold/italic/bulletList/orderedList). Hien qua modal rieng o FE
  // (GroupGoalModal.tsx), chi chu workspace duoc sua (assertGroupOwner, giong
  // update() cac field khac cua nhom).
  goal          Json?
  // "Lo trinh hoc tap" - Tiptap JSON, schema DAY DU (getPostExtensions(),
  // giong Document.content - can heading/nested list de note outline dang
  // cum/topic/nhieu truong long nhau), KHAC goal (schema han che, chi 1 doan
  // ngan). Hien o "trang" rieng GroupRoadmapSection.tsx (muc "Lộ trình"
  // trong GroupSidebar.tsx), CHI chu workspace duoc sua (assertGroupOwner,
  // giong goal).
  roadmap       Json?
  // Ten/ma chung chi MUC TIEU cua nhom (vd "AWS Solutions Architect"/"SAA-C03") -
  // hien trong GroupProgressWidget.tsx (tab Tong quan khi doc bai), sua qua
  // GroupCertSettingsModal.tsx. Ca 2 null = chua thiet lap, widget an di.
  certName      String?
  certCode      String?
  visibility    KnowledgeGroupVisibility     @default(PRIVATE)
  // Cache so bai viet - dong bo trong $transaction khi Document duoc tao/xoa
  // trong nhom nay, giong pattern Community.memberCount.
  postCount     Int                          @default(0)
  orderIndex    Int                          @default(0)
  documents     Document[]
  series        DocumentSeries[]
  collaborators KnowledgeGroupCollaborator[]
  notifications Notification[]
  studyDays     KnowledgeGroupStudyDay[]
  objectives    LearningObjective[]
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@index([workspaceId, orderIndex])
}

// 1 dong = 1 NGAY (khong gio) nhom co hoat dong that (tao/sua bai, doi
// trang thai checklist - xem KnowledgeGroupAccessService.recordStudyDay).
// @db.Date (chi ngay) de @@unique gop dung theo ngay, khong bi nhan doi neu
// co nhieu hoat dong trong cung 1 ngay. Dung tinh "so ngay hoc"/"streak" cho
// GroupProgressWidget.tsx.
model KnowledgeGroupStudyDay {
  id               String         @id @default(uuid())
  knowledgeGroupId String
  knowledgeGroup   KnowledgeGroup @relation(fields: [knowledgeGroupId], references: [id], onDelete: Cascade)
  date             DateTime       @db.Date
  createdAt        DateTime       @default(now())

  @@unique([knowledgeGroupId, date])
  @@index([knowledgeGroupId])
}

enum KnowledgeGroupCollabStatus {
  PENDING
  APPROVED
  REJECTED
}

// Yeu cau cong tac tren 1 KnowledgeGroup - GIONG HET pattern CommunityMember
// (status PENDING/APPROVED/REJECTED, joinReason tu do, 404-on-fail convention
// o service layer). APPROVED = duoc viet bai chung trong nhom (quyen GHI
// thuc su, khong chi quyen XEM) - ap dung cho CA group PUBLIC lan PRIVATE, vi
// visibility chi gate xem, khong gate quyen ghi.
model KnowledgeGroupCollaborator {
  id         String                     @id @default(uuid())
  groupId    String
  group      KnowledgeGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     KnowledgeGroupCollabStatus @default(PENDING)
  joinReason String?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  @@unique([groupId, userId])
  @@index([groupId, status])
  @@index([userId])
}

enum NotificationType {
  // Gui toi CHU workspace so huu nhom khi co nguoi xin cong tac.
  GROUP_COLLAB_REQUESTED
  // Gui toi NGUOI XIN khi yeu cau duoc duyet/tu choi.
  GROUP_COLLAB_APPROVED
  GROUP_COLLAB_REJECTED
  // Gui toi NGUOI DUOC FOLLOW khi co nguoi moi follow (xem FollowService).
  FOLLOW
}

// He thong thong bao - hien CHI phuc vu luong "yeu cau cong tac nhom kien
// thuc" (3 loai o tren), thiet ke du rong de mo rong loai khac sau nay
// (moi loai la 1 gia tri enum + cach dien giai rieng o FE, khong can bang
// rieng). `actorId` nullable (SetNull) - giu lai thong bao ke ca khi actor
// bi xoa tai khoan; `groupId` gan CASCADE theo nhom (nhom xoa thi thong bao
// ve no khong con y nghia). `collabId` la tham chieu MEM (khong FK that toi
// KnowledgeGroupCollaborator) - collaborator co the bi xoa qua leave() sau
// khi thong bao da ton tai, khong muon rang buoc/cascade xoa lich su thong
// bao theo do; FE dung field nay de goi thang endpoint duyet/tu choi.
model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  groupId     String?
  group       KnowledgeGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  collabId    String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

// "Bai viet" trong 1 Knowledge Group (UI goi la "bai viet"/"post", TEN MODEL
// giu nguyen "Document" - doi ten se keo theo sua co hoc toan bo
// src/document/**, DTO, lib/api/documents.ts, cac server action/component
// frontend ma khong doi hanh vi gi, chi tang rui ro. Tuong tu cach schema nay
// da tolerate `PostCategory` (enum feed) khac `CommunityPostCategory` du
// trung y nghia ten - xem comment o tren). Do la bai viet dai do chinh nguoi
// dung soan bang editor lon (Tiptap JSON), THUOC VE 1 KnowledgeGroup (truoc
// day thuoc thang ve tac gia, khong qua nhom nao). Khac CommunityPost (bai
// ngan trong 1 kenh) va Post (feed kham pha) - day la "bai viet" co the ghim,
// co trang doc rieng /u/[username]/workspaces/[slug], va co the "chia se len
// bang tin" (tao 1 Post that, xem PostService.create trong document.service.ts).
// `content` la Tiptap JSON (giong Node.content / Card.content cu). Slug DUY
// NHAT trong pham vi 1 tac gia (2 nguoi khac nhau co the cung slug).
model Document {
  id               String          @id @default(uuid())
  authorId         String
  author           User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  knowledgeGroupId String
  knowledgeGroup   KnowledgeGroup  @relation(fields: [knowledgeGroupId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  summary          String? // mo ta ngan, hien o the danh sach + og description
  // Tong quan noi dung - Tiptap JSON nhung schema HAN CHE (chi in dam/in
  // nghieng/danh sach cham/danh sach so, xem getOverviewExtensions() o FE).
  // Hien thanh 1 box duoi tieu de trong danh sach bai viet - KHAC voi
  // `summary` (plain text, dung cho OG description) va `content` (bai day du).
  overview         Json?
  coverImageUrl    String? // anh bia (nhap qua URL - chua co upload S3)
  content          Json // Tiptap/ProseMirror JSON
  tags             String[]        @default([])
  isPinned         Boolean         @default(false) // ghim len dau danh sach bai trong nhom
  isPublished      Boolean         @default(true) // false = ban nhap, chi tac gia thay
  viewCount        Int             @default(0)
  // Nhom "cung chu de" (tuy chon) - xem comment model DocumentSeries. 1 bai
  // CHI thuoc 1 series (khong many-to-many, giu don gian cho UI gop box).
  // onDelete: SetNull - xoa series KHONG xoa bai viet theo, chi roi ve
  // "khong nhom".
  seriesId         String?
  series           DocumentSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  // "Nhat ky hoc tap" cong khai gan tren bai viet - xem comment model
  // ChecklistItem. Cờ nay CHI gate viec nguoi đọc KHÁC co xem duoc LICH SU
  // (ChecklistItemLog) hay khong - trang thai/note hien tai cua tung muc
  // LUON cong khai (khong gate boi co nay), dung y dinh "nhat ky cong khai".
  checklistLogPublic Boolean        @default(false)
  checklistItems   ChecklistItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([authorId, slug])
  @@index([authorId, isPinned, updatedAt])
  @@index([knowledgeGroupId, isPinned, updatedAt])
  @@index([seriesId])
}

// NOT_UNDERSTOOD/UNDERSTOOD la 2 gia tri GOC (giu nguyen ten de tranh migration
// rename enum value rui ro) - IN_PROGRESS/NEEDS_REVIEW la 2 trang thai THEM
// (○ Chua hoc / ◐ Dang hoc / ✓ Da nam / ⚠ Can on, xem ArticleChecklist.tsx).
// Cac cho tinh progress (knowledge-group.service.ts, workspace.service.ts)
// van CHI dem UNDERSTOOD la "xong" - IN_PROGRESS/NEEDS_REVIEW khong doi y
// nghia do.
enum ChecklistStatus {
  NOT_UNDERSTOOD
  IN_PROGRESS
  UNDERSTOOD
  NEEDS_REVIEW
}

// Nhom 1 muc checklist thuoc ve section nao trong "Ke hoach hoc tap"
// (ArticleChecklist.tsx) - OBJECTIVE mac dinh (item cu truoc khi co field nay
// deu la muc "Can nam").
enum ChecklistGroup {
  OBJECTIVE
  RESOURCE
  PRACTICE
  ASSESSMENT
}

// Checklist kien thuc gan tren 1 Document - tac gia liet ke cac topic can
// nam ("Version", "Statement"...), tu danh dau da hieu/chua + ghi 1 note
// ngan ("rut ra duoc dieu gi"). Trang thai/note LUON cong khai cho nguoi doc
// khac xem (read-only) - day la "nhat ky hoc" chia se, khong phai TODO rieng
// tu. Chi LICH SU đổi trạng thái (ChecklistItemLog) bi gate boi
// Document.checklistLogPublic.
model ChecklistItem {
  id         String            @id @default(uuid())
  documentId String
  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  label      String
  status     ChecklistStatus   @default(NOT_UNDERSTOOD)
  group      ChecklistGroup    @default(OBJECTIVE)
  note       String? // ghi chu HIEN TAI, sua duoc doc lap voi status
  orderIndex Int               @default(0)
  logs       ChecklistItemLog[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([documentId, orderIndex])
}

// 1 dong lich su MOI LAN doi status - note la SNAPSHOT cua ChecklistItem.note
// tai đúng thoi diem đổi (khong phai note hien tai), de nhat ky giu duoc
// "luc do minh hieu gi" ngay ca khi note sau nay bi sua tiep. Tu sinh o
// server trong ChecklistService.updateStatus, khong co endpoint tu ghi rieng.
model ChecklistItemLog {
  id              String          @id @default(uuid())
  checklistItemId String
  checklistItem   ChecklistItem   @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  toStatus        ChecklistStatus
  note            String?
  createdAt       DateTime        @default(now())

  @@index([checklistItemId, createdAt])
}

enum ObjectiveItemType {
  KNOWLEDGE
  SKILL
}

// "Mục tiêu học tập" cua 1 nhom - danh sach NHIEU Objective (vd "1.1 Design
// secure access to AWS resources"), khac han KnowledgeGroup.goal (1 o
// rich-text TU DO gan CA nhom, khong lien quan field nay - xem GroupGoalModal.tsx).
// Moi Objective co cac item phan loai Knowledge (biet)/Skill (lam duoc) -
// xem enum ObjectiveItemType. Thay the placeholder "Sắp ra mắt" cua muc "Mục
// tiêu" trong GroupSidebar.tsx.
model LearningObjective {
  id               String                  @id @default(uuid())
  knowledgeGroupId String
  knowledgeGroup   KnowledgeGroup          @relation(fields: [knowledgeGroupId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  orderIndex       Int                     @default(0)
  items            LearningObjectiveItem[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([knowledgeGroupId, orderIndex])
}

// 1 muc Knowledge/Skill trong 1 Objective - tai su dung ChecklistStatus (4
// muc, cung y nghia voi "Kế hoạch học tập" cua bai viet - xem ChecklistItem)
// thay vi tu 1 enum trang thai rieng.
model LearningObjectiveItem {
  id          String            @id @default(uuid())
  objectiveId String
  objective   LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  type        ObjectiveItemType
  label       String
  status      ChecklistStatus   @default(NOT_UNDERSTOOD)
  note        String? // ghi chu HIEN TAI, dung mo modal rieng giong ChecklistRow
  orderIndex  Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([objectiveId, type, orderIndex])
}

// Nhom nhieu Document "cung chu de" trong 1 KnowledgeGroup thanh 1 box rieng
// trong danh sach bai viet (vien mo nhe + ten nhom tuy chinh) - xem
// ArticleCard.tsx/WorkspaceMain.tsx o FE. Scope trong DUNG 1 KnowledgeGroup
// (khong xuyen nhom/workspace) vi UI gop chi hien trong dung 1 list dang xem.
model DocumentSeries {
  id               String         @id @default(uuid())
  knowledgeGroupId String
  knowledgeGroup   KnowledgeGroup @relation(fields: [knowledgeGroupId], references: [id], onDelete: Cascade)
  name             String
  // Nhan phan loai o TREN series (vd "Networking" cho series "VPC"/"Route 53") -
  // tuy chon, null = "Chưa phân loại" o FE. Phuc vu cay 2 cap Roadmap/Kien
  // thuc (category -> series) o man Workspace (thuc chat la KnowledgeGroup)
  // moi - xem docs/... (khong co migration rieng, chi 1 cot don).
  category         String?
  orderIndex       Int            @default(0)
  documents        Document[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([knowledgeGroupId, orderIndex])
}

// Chat 1-1 (MVP - xem docs khao sat truoc khi lam, chua co gi ca truoc dot
// nay). Model tach rieng Conversation/ConversationParticipant/Message (thay
// vi 1 cot participantIds tren Conversation) de mo rong duoc len group chat
// sau nay ma khong can migration lai, du hien tai ChatService chi cho phep
// dung 2 participant. `updatedAt` tren Conversation bump moi khi co Message
// moi (xem ChatService.sendMessage) - dung de sap xep danh sach hoi thoai
// theo "moi nhat len dau" ma khong can join/aggregate Message moi lan list.
model Conversation {
  id           String                     @id @default(uuid())
  participants ConversationParticipant[]
  messages     Message[]
  // isGroup=false: 1-1 (nhu tu truoc gio, luon dung 2 participants). isGroup=true:
  // nhom (>= 3 participants) - name bat buoc, avatarColor la 1 trong so mau
  // co dinh nguoi tao chon luc tao (CHUA co upload anh that, xem
  // CreateGroupModal.tsx o frontend), luu lai co dinh CHO NHOM DO chu khong
  // phai random moi lan render.
  isGroup      Boolean                    @default(false)
  name         String?
  avatarColor  String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

// lastReadAt: moc "da doc den dau" cua TUNG nguoi trong hoi thoai - unreadCount
// tinh bang dem Message.createdAt > lastReadAt (null = chua doc gi, tat ca
// deu tinh la chua doc). isFavorite/isMuted/isRestricted la cai dat RIENG
// cua TUNG nguoi ve hoi thoai nay (khong doi xung - toi tat thong bao khong
// lam nguoi kia bi tat theo), nen nam tren participant row chu khong phai
// Conversation.
model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  isFavorite     Boolean      @default(false)
  isMuted        Boolean      @default(false)
  // "Han che" o pham vi MVP = tat thong bao/toast + hien mo trong danh sach,
  // KHONG lam day du co che "hop thu yeu cau an" cua Instagram (doi hoi
  // hang doi rieng, nguoi bi han che khong biet - ngoai pham vi yeu cau).
  isRestricted   Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

// TEXT: content bat buoc (nhu cu). Cac loai con lai: content la caption
// TUY CHON, du lieu chinh nam o attachment* (IMAGE/FILE/VOICE/GIF) hoac
// quan he `poll` (POLL) - xem ChatService.sendMessage.
enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  GIF
  POLL
}

model Message {
  // ULID (khong dung uuid()) - sinh o app (ChatService.sendMessage) de id tu
  // sap xep theo thoi gian, dung lam cursor phan trang xem tin nhan cu
  // (orderBy: id thay vi createdAt - id la unique + sortable, tranh dung
  // createdAt lam cursor field vi co the trung nhau khi nhieu tin gui cung
  // luc, gay phan trang khong on dinh/lap-sot tin).
  id             String       @id
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type           MessageType  @default(TEXT)
  content        String?
  // IMAGE/FILE/VOICE/GIF dung chung 4 field nay - upload that di qua
  // UploadService (AWS S3), xem uploads.module.ts. GIF: attachmentUrl la link
  // Giphy, khong upload len S3.
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  // Chi VOICE dung - do dai ban ghi am (giay), FE hien "0:42" tren bubble.
  durationSeconds    Int?
  poll               Poll?
  // Reply/quote - tro toi 1 Message KHAC trong CUNG hoi thoai (khong validate
  // o schema, ChatService tu kiem tra). SetNull khi tin goc bi xoa/thu hoi de
  // khong lam vo chuoi reply (con lai la "tin nhan da bi xoa" o phia FE dua
  // vao replyTo null + replyToId con gia tri... thuc te KHONG xoa cung Message
  // - xem isRecalled, nen truong hop SetNull hiem xay ra tren thuc te).
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")
  // Thu hoi (unsend) - CHI nguoi gui thu hoi duoc tin cua chinh minh. Giu
  // nguyen row (khong xoa that) de khong pha vo thu tu/reply chain - FE hien
  // "Tin nhắn đã được thu hồi" thay vi content/attachment that.
  isRecalled Boolean         @default(false)
  reactions  MessageReaction[]
  createdAt  DateTime        @default(now())
  // Cot GENERATED (STORED) o DB - Postgres tu tinh lai moi khi `content` doi,
  // KHONG ghi tu Prisma (Unsupported = Prisma bo qua field nay khi build
  // query thuong, chi truy van duoc qua $queryRaw). Xem migration
  // "message_search_vector" de biet bieu thuc sinh gia tri (to_tsvector
  // config "simple" + unaccent) va docs/chat-search-architecture.md de biet
  // ly do chon huong nay.
  searchVector Unsupported("tsvector")?

  @@index([conversationId, createdAt])
  // Ho tro cursor pagination trong listMessages (orderBy: id, cursor: { id }).
  @@index([conversationId, id])
}

// 1 nguoi CHI co toi da 1 reaction/tin nhan (giong Messenger/Zalo, khong
// phai kieu Discord nhieu emoji chong nhau) - doi emoji = ghi de (upsert),
// khong tao them dong moi.
model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

// 1-1 voi Message (type = POLL) - cau hoi + danh sach option, KHONG cho sua
// sau khi tao (giong tin nhan thuong).
model Poll {
  id        String       @id @default(uuid())
  messageId String       @unique
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  question  String
  options   PollOption[]
  createdAt DateTime     @default(now())
}

model PollOption {
  id     String     @id @default(uuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  votes  PollVote[]

  @@index([pollId])
}

// Luon single-choice cho MVP (khong co allowMultiple) - PollService dam bao
// 1 nguoi chi co toi da 1 vote CON SONG trong toan bo poll (xoa vote cu truoc
// khi tao vote moi neu doi lua chon), @@unique chi de chan double-click tren
// CUNG 1 option.
model PollVote {
  id           String     @id @default(uuid())
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([pollOptionId, userId])
  @@index([userId])
}
