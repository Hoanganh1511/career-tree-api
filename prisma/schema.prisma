// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String       @id @default(uuid())
  googleId          String       @unique
  email             String       @unique
  name              String
  // Dashboard Skill Tree: dung de so sanh benchmark theo nam kinh nghiem
  // (Phase 4) - de null neu nguoi dung chua khai bao.
  yearsOfExperience Int?
  // "Dang xuat khoi moi thiet bi": moi token noi bo co `iat` TRUOC moc nay
  // deu bi tu choi (xem JwtAuthGuard). Session cua Auth.js la JWT stateless
  // (khong co session store) nen day la cach duy nhat thu hoi duoc session
  // ma khong phai doi ca co che session - xem docs/user-schema-design.md.
  tokensValidAfter  DateTime?
  // Danh tinh cong khai cho feed (Post.author) - xem docs/user-schema-design.md
  // muc 4.1/4.2 (Phase 1). Nullable vi user dong bo qua Google sync KHONG co
  // san 3 field nay (Google chi cho googleId/email/name/picture) - UserService
  // tu sinh username tu email luc sync neu con null.
  username          String?      @unique
  avatarUrl         String?
  verified          Boolean      @default(false)
  // Modal chao mung 3 buoc tren /home - null = chua tung hoan tat/bo qua,
  // co gia tri = an modal vinh vien (ben qua nhieu thiet bi, xem
  // UserService.completeOnboarding).
  onboardedAt       DateTime?
  // 1 trong 4 gia tri co dinh ("self"/"learn"/"career"/"community") chon o
  // buoc 2 modal chao mung - luu that nhung CHUA co logic tieu thu (giong
  // UserProfile.bio/pronouns hien tai).
  onboardingGoal    String?
  // Admin GL Daily Diary - CHI 1 tai khoan duy nhat (chinh chu app) dung
  // thu cong qua SQL sau khi migrate (khong co UI quan ly nhieu admin, app
  // khong co khai niem admin toan cuc nao khac - xem AdminGuard). KHONG lien
  // quan CommunityMemberRole (role do scoped rieng theo tung community).
  isAdmin           Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  posts             Post[]
  followerCount     Int          @default(0)
  followingCount    Int          @default(0)
  following         UserFollow[] @relation("Follower")
  followedBy        UserFollow[] @relation("Followee")
  blocksMade        UserBlock[]  @relation("Blocker")
  blockedBy         UserBlock[]  @relation("Blocked")
  profile           UserProfile?

  communitiesOwened            Community[]
  communityMemberships         CommunityMember[]
  communityPosts               CommunityPost[]
  comments                     Comment[]
  reactions                    Reaction[]
  requestedChannels            Channel[]                    @relation("ChannelRequestedBy")
  notificationsReceived        Notification[]               @relation("NotificationRecipient")
  notificationsActedOn         Notification[]               @relation("NotificationActor")
  conversationParticipations   ConversationParticipant[]
  messagesSent                 Message[]
  pollVotes                    PollVote[]
  messageReactions             MessageReaction[]
  diaryTopics                  DiaryTopic[]
  postCollections              PostCollection[]
  postComments                 PostComment[]
  postCommentLikes             PostCommentLike[]
  postLikes                    PostLike[]
  savedPosts                   SavedPost[]
}

// Feed Trang chu - truoc day 100% mock o frontend (enggo/src/content/
// home-feed-mock.ts), gio la du lieu that. 1 bang CHUNG cho ca 24 "kind" bai
// dang (dung 1 bang + cot `data: Json` chua field rieng tung loai, giong cach
// Card.content dang lam cho Node) thay vi 24 bang/cot rieng - tranh no schema.
// `kind` luu SCREAMING_SNAKE (dung convention enum cua repo); API tra ve/nhan
// vao dang kebab-case ("skill-report") khop voi frontend Post["kind"] union -
// chuyen doi 2 chieu nam trong post.service.ts (PostModule), KHONG trong DTO.
enum PostKind {
  TEXT
  IMAGE
  GALLERY
  VIDEO
  FILE
  LINK
  RESOURCE
  NOTE
  PROJECT_UPDATE
  ACHIEVEMENT
  MILESTONE
  QUESTION
  POLL
  CAREER_UPDATE
  SKILL_UPDATE
  NODE_CREATED
  KNOWLEDGE_BLOCK
  TIMELINE_EVENT
  CODE_SNIPPET
  IDEA
  TUTORIAL
  EXPERIMENT
  EVENT
  SKILL_REPORT
  WORKSPACE_POST
}

enum FollowStatus {
  ACTIVE
  PENDING
}

// "Topic" cua bai dang (vd Frontend/Backend/LLM/...) - khop 1-1 voi danh sach
// topic trong enggo/src/lib/discover/knowledge-worlds.ts (slug kebab-case ben
// frontend -> UPPER_SNAKE_CASE o day, vd "ai-agents" -> AI_AGENTS). Day la
// TANG LOC DUOC (co index), khac "topic" trong `data` JSON (tu do, chi de
// hien thi breadcrumb, khong index duoc - ten trung nhau nhung 2 khai niem
// khac nhau).
//
// GAME_DEV/IOT/DEV_TOOLS/DATA_AI/UI_UX/CAREER/SOFT_SKILLS/QA_TEST/SECURITY la
// gia tri CU tu taxonomy nghe nghiep truoc day (category-taxonomy.ts, da xoa)
// - GIU LAI vi da co bai seed gan gia tri nay, khong con duoc UI moi
// (knowledge-worlds.ts) su dung de tao pill/topic nua.
enum PostCategory {
  FRONTEND
  BACKEND
  MOBILE
  GAME_DEV
  BLOCKCHAIN
  IOT
  DEV_TOOLS
  DATA_AI
  DATABASE
  PRODUCT
  UI_UX
  DEVOPS
  CLOUD
  SYSTEM_DESIGN
  SECURITY
  QA_TEST
  CAREER
  SOFT_SKILLS
  // --- Them cho Knowledge World "Think" ---
  ALGORITHMS
  ARCHITECTURE
  PERFORMANCE
  DISTRIBUTED_SYSTEMS
  // --- Them cho Knowledge World "AI" ---
  PROMPT_ENGINEERING
  LLM
  AI_AGENTS
  MCP
  RAG
  COMPUTER_VISION
  // --- Them cho Knowledge World "Create" ---
  UI
  UX
  MOTION
  FIGMA
  DESIGN_SYSTEM
  // --- Them cho Knowledge World "Career" (topic con, khac CAREER cu o tren) ---
  RESUME
  INTERVIEW
  PRODUCTIVITY
  REMOTE
  FREELANCE
  // --- Them cho Knowledge World "Business" ---
  STARTUP
  GROWTH
  MARKETING
}

// Phan loai bai dang theo LINH VUC NGHE NGHIEP - 2 tang (nhom cha -> nhanh
// con), khac voi `PostCategory` (enum) - truc "topic" cua Knowledge Worlds
// (FRONTEND/LLM/...). 1 post co the mang CA HAI phan loai (vd
// topic=PERFORMANCE + nghe nghiep="Lap trinh web/mobile") nen phai la 2 cot
// rieng, khong gop.
//
// Danh sach nhom/nhanh dinh nghia san qua seed (prisma/seed-posts.ts), user
// KHONG tu tao duoc.
model CareerCategoryGroup {
  id         String           @id @default(uuid())
  slug       String           @unique
  name       String
  icon       String? // slug lucide, tuy chon
  // CHI dung lam tie-breaker khi 2 nhom bang nhau ve so post 7 ngay - thu tu
  // hien thi that do so post quyet dinh (xem FeedCategoryService).
  orderIndex Int              @default(0)
  categories CareerCategory[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model CareerCategory {
  id         String              @id @default(uuid())
  groupId    String
  group      CareerCategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slug       String              @unique
  name       String
  orderIndex Int                 @default(0)
  posts      Post[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([groupId])
}

// CONTEST = cuoc thi co giai thuong/han chot; TOPIC = chu de viet bai thuong
// truc (khong giai). Ca 2 deu hien thi duoi dang 1 hashtag.
enum ContestKind {
  CONTEST
  TOPIC
}

enum ContestStatus {
  OPEN
  JUDGING
  CLOSED
}

model Contest {
  id            String        @id @default(uuid())
  slug          String        @unique
  hashtag       String        @unique // luu KHONG kem dau #, UI tu them
  title         String
  description   String
  kind          ContestKind
  status        ContestStatus @default(OPEN)
  partnerName   String? // "Asahi Beverages" -> UI hien "voi ..."
  coverImageUrl String?
  accent        String? // hex cho vien the + nen anh bia
  prize         String?
  deadline      DateTime?
  // So tinh san, cung loi voi Post.likesCount - seed cap nhat cho khop so
  // ban ghi PostContest that.
  postCount     Int           @default(0)
  posts         PostContest[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

// Bang noi tuong minh (dung convention nhu UserFollow/UserBlock) - 1 bai co
// the tham gia nhieu contest/chu de cung luc.
model PostContest {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  contestId String
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, contestId])
  @@index([contestId, createdAt])
}

model UserBlock {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockerId])
}

model UserFollow {
  followerId String
  follower   User         @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User         @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  status     FollowStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId, createdAt])
  @@index([followerId, createdAt])
}

// Compose Giai doan 2 - DRAFT/PUBLIC deu de hieu, LIMITED = "Cong khai gioi
// han" kieu Unlisted (an khoi feed/tim kiem mac dinh, nhung GET posts/:id
// van mo cho BAT KY ai co link - khong can he thong follow/quyen rieng).
// Xem post-visibility.util.ts cho mapping kebab-case (API) <-> enum nay.
enum PostVisibility {
  DRAFT
  PUBLIC
  LIMITED
}

model Post {
  id               String               @id @default(uuid())
  authorId         String
  author           User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind             PostKind
  // Linh vuc bai dang thuoc ve (Frontend/Backend/...) - optional vi khong
  // phai kind nao cung can gan (vd poll/idea co the khong chon). Day la cot
  // that, co index, dung de loc o GET /posts?category=... (xem
  // PostController) - KHAC "topic" (van nam trong `data` JSON ben duoi, chi
  // de hien thi, khong dung de loc).
  category         PostCategory?
  // Linh vuc NGHE NGHIEP cua bai (2 tang, xem CareerCategoryGroup) - truc loc
  // DOC LAP voi `category` o tren: `category` la topic Knowledge World, cot
  // nay la nganh nghe. Null = bai "Chia se chung" (khong gan nganh cu the).
  careerCategoryId String?
  careerCategory   CareerCategory?      @relation(fields: [careerCategoryId], references: [id], onDelete: SetNull)
  // Field rieng tung kind (content/title/image/poll options/...) - shape khop
  // voi tung nhanh cua Post union o frontend, TRU cac field icon/accent rieng
  // le (achievement/project-update/knowledge-block/tutorial/link/resource) -
  // nhung field do gio lay theo KIND tu POST_KIND_META o frontend thay vi luu
  // rieng tung post, tranh phai serialize component icon (khong the luu DB).
  data             Json
  // Tieu de that - TRUOC DAY chi la state cuc bo tren Composer.tsx, tu ghep
  // vao dong dau `content` (mat han neu excerpt duoc dien, vi content luc do
  // = excerpt, khong con cho tieu de). Promote thanh cot that (giong excerpt
  // duoi day) de khong mat du lieu + de tinh nang Sua bai hydrate lai dung.
  title            String?
  // Compose "redesign mobile" - nguoi dung tu viet tom tat (truoc day
  // PostService tu cat 600 ky tu dau content). Optional: neu client khong
  // gui, PostService van fallback tu cat nhu cu (xem post.service.ts).
  excerpt          String?
  // Compose Giai doan 2 - visibility that (loc o PostService.findAll/findOne,
  // xem post.service.ts), 3 co cho phep/tim kiem CHI la du lieu THAT duoc luu
  // lai, CHUA co he thong Comment/Reaction/tim kiem Post nao tieu thu chung -
  // giong dung tinh than da chot o Giai doan 1 (luu that, chua co gi dung toi).
  visibility       PostVisibility       @default(PUBLIC)
  commentsEnabled  Boolean              @default(true)
  likesEnabled     Boolean              @default(true)
  searchable       Boolean              @default(true)
  // Denormalized - tang/giam trong transaction luc thich/bo thich (cung
  // tinh than PostComment.likesCount), tranh COUNT() moi lan hien thi. Da co
  // bang PostLike that (xem duoi) tu 2026-09-12 - TRUOC DAY chi la tuong tac
  // cuc bo tren ArticleActionBar.tsx, khong luu DB.
  likesCount       Int                  @default(0)
  commentsCount    Int                  @default(0)
  repostsCount     Int                  @default(0)
  contests         PostContest[]
  collectionItems  PostCollectionItem[]
  comments         PostComment[]
  likes            PostLike[]
  savedBy          SavedPost[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([category, createdAt])
  @@index([careerCategoryId, createdAt])
  @@index([visibility, createdAt])
}

// Like that cho Post - cung khuon voi PostCommentLike (userId+postId lam
// composite key, khong id rieng - 1 nguoi chi thich 1 post 1 lan).
model PostLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

// "Đã lưu" - danh sach bookmark DON GIAN, RIENG BIET voi PostCollection (bo
// suu tap nguoi dung tu dat ten/gom nhom). Bam nut Luu tren bai la LUU/BO
// NGAY vao day (khong hien popover chon bo suu tap nao ca) - PostCollection
// van giu nguyen, khong lien quan. Cung khuon voi PostLike (composite key
// userId+postId, khong id rieng). @@index([userId, createdAt]) de liet ke
// "Bài đã lưu" cua 1 nguoi, moi nhat truoc, khong can COUNT/JOIN phu.
model SavedPost {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([userId, createdAt])
}

enum PostCollectionVisibility {
  PUBLIC
  PRIVATE
}

// Chu de rong (khac han PostCategory - enum do toan nhanh cong nghe/ky
// thuat chi tiet, dung cho Post.category, KHONG hop voi bo suu tap vi bo
// suu tap co the ve bat ky de tai nao - vd "Lich su Viet Nam"/"Training
// Gym" trong mockup nguoi dung gui). Nullable tren model = coi nhu "Khac"
// khi loc/dem, khong bat buoc chon luc tao.
enum PostCollectionTopic {
  TECH
  LIFE
  LEARNING
  CREATIVITY
  BUSINESS
  SPORTS
  CULTURE
  HISTORY
  OTHER
}

// "Bo suu tap" nguoi dung tu tao de gom Post lai theo chu de rieng (khac
// han model Collection ben duoi, thuoc 1 nhanh noi dung khoa hoc/tai lieu
// da chet - khong dung nham). userId KHONG @@unique voi title - 1 nguoi co
// the tao nhieu bo suu tap trung ten, khong can rang buoc.
model PostCollection {
  id            String                   @id @default(uuid())
  userId        String
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  coverImageUrl String?
  visibility    PostCollectionVisibility @default(PUBLIC)
  topic         PostCollectionTopic?
  // Denormalized - tang/giam trong transaction luc them/xoa item (cung tinh
  // than followerCount/followingCount cua UserFollow), tranh COUNT() moi lan
  // liet ke danh sach bo suu tap.
  postCount     Int                      @default(0)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  items         PostCollectionItem[]

  @@index([userId, createdAt])
}

model PostCollectionItem {
  collectionId String
  collection   PostCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  postId       String
  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  addedAt      DateTime       @default(now())

  @@id([collectionId, postId])
  @@index([postId])
}

// Binh luan THAT cho Post thuong - KHONG dung chung voi model `Comment`
// (gan cung vao CommunityPost, kiem tra quyen qua CommunityAccessService -
// thuoc mien cong dong, khong ap dung duoc cho Post) - xay song song, dung
// tinh than PostCollection da lam voi Collection cu khong lien quan. Reply
// tu tham chieu (parentId) nhung UI CHI cho sau 1 cap (goc -> reply, khong
// reply-cua-reply) - schema van cho phep sau hon ve mat ky thuat, KHONG bat
// buoc rang buoc o DB, chi UI tu gioi han.
model PostComment {
  id         String            @id @default(uuid())
  postId     String
  post       Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String
  author     User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     PostComment?      @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    PostComment[]     @relation("PostCommentReplies")
  content    String
  // Denormalized - tang/giam trong transaction luc thich/bo thich (cung
  // tinh than postCount cua PostCollection), tranh COUNT() moi lan liet ke.
  likesCount Int               @default(0)
  likes      PostCommentLike[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
}

model PostCommentLike {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([userId, commentId])
  @@index([commentId])
}

model UserProfile {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String?
  coverImageUrl String?
  location      String?
  websiteUrl    String?
  pronouns      String?
  // Redesign Settings - "Vai trò" (vd "Software Engineer") hien trang thai
  // cong khai, KHONG lien quan yearsOfExperience (Dashboard Skill Tree) tren
  // User.
  role          String?
  // Mang xa hoi cong khai (sidebar trang chi tiet bai viet, enggo) - moi
  // field 1 URL day du (co san "https://", khop cach luu websiteUrl o tren).
  // Tach rieng tung cot (khong gop 1 field JSON) de dung chung duoc pattern
  // validate @IsUrl() tung field don gian nhu websiteUrl, khong can parse
  // JSON o backend.
  twitterUrl    String?
  facebookUrl   String?
  instagramUrl  String?
  youtubeUrl    String?
  linkedinUrl   String?
  rssUrl        String?
  postCount     Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Community {
  id          String            @id @default(uuid())
  slug        String            @unique
  name        String
  description String
  isPublic    Boolean           @default(true)
  memberCount Int               @default(0) //cache, cap nhat khi CommunityMember.status -> APPROVED
  ownerId     String?
  owner       User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  channels    Channel[]
  members     CommunityMember[]
  posts       CommunityPost[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum ChannelGroup {
  KNOWLEDGE
  TOOLS
}

enum ChannelStatus {
  PENDING
  APPROVED
  REJECTED
}

model Channel {
  id             String          @id @default(uuid())
  communityId    String
  community      Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  group          ChannelGroup    @default(KNOWLEDGE)
  description    String
  bannerImageUrl String?
  messageCount   Int             @default(0) //cache
  orderIndex     Int             @default(0)
  // Kenh do OWNER/ADMIN tao -> APPROVED ngay; thanh vien thuong de xuat ->
  // PENDING, cho quan tri duyet (xem ChannelService.create). Danh sach kenh
  // hien thi (findAllForCommunity, CommunityService.findBySlug) CHI lay
  // APPROVED - PENDING/REJECTED khong lo ra ngoai tru cho moderator xem qua
  // channelRequests.
  status         ChannelStatus   @default(PENDING)
  requestedById  String?
  requestedBy    User?           @relation("ChannelRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  posts          CommunityPost[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([communityId, slug])
  @@index([communityId])
  @@index([communityId, status])
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  MENTOR
  MEMBER
}

enum CommunityMemberStatus {
  PENDING
  APPROVED
  REJECTED
}

model CommunityMember {
  id          String                @id @default(uuid())
  communityId String
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CommunityMemberRole   @default(MEMBER)
  status      CommunityMemberStatus @default(PENDING)
  points      Int                   @default(0) // diem hoat dong, hien "X diem" o activeMembers
  joinReason  String? // ly do xin tham gia, ung voi CommunityJoinRequestDetailed.reason
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([communityId, userId])
  @@index([communityId, status])
  @@index([userId])
}

enum CommunityPostCategory {
  LEARNING
  QUESTION
  RESOURCE
}

model CommunityPost {
  id            String                 @id @default(uuid())
  communityId   String
  community     Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  channelId     String
  channel       Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      CommunityPostCategory?
  title         String?
  content       String
  data          Json?
  isPinned      Boolean                @default(false)
  likesCount    Int                    @default(0)
  commentsCount Int                    @default(0)
  comments      Comment[]
  reactions     Reaction[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([channelId, createdAt])
  @@index([communityId, createdAt])
  @@index([authorId])
}

model Comment {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?      @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentToComment")
  content   String
  reactions Reaction[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model Reaction {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  postId    String?
  post      CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, postId, emoji])
  @@unique([userId, commentId, emoji])
  @@index([postId])
  @@index([commentId])
}

enum NotificationType {
  // Gui toi NGUOI DUOC FOLLOW khi co nguoi moi follow (xem FollowService).
  FOLLOW
}

// He thong thong bao - truoc day con 3 loai "yeu cau cong tac nhom kien
// thuc" (GROUP_COLLAB_*) va cot groupId/collabId, da bo cung luc xoa tinh
// nang Workspace/KnowledgeGroup (2026-09-14) - gio chi con FOLLOW.
model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

// Chat 1-1 (MVP - xem docs khao sat truoc khi lam, chua co gi ca truoc dot
// nay). Model tach rieng Conversation/ConversationParticipant/Message (thay
// vi 1 cot participantIds tren Conversation) de mo rong duoc len group chat
// sau nay ma khong can migration lai, du hien tai ChatService chi cho phep
// dung 2 participant. `updatedAt` tren Conversation bump moi khi co Message
// moi (xem ChatService.sendMessage) - dung de sap xep danh sach hoi thoai
// theo "moi nhat len dau" ma khong can join/aggregate Message moi lan list.
model Conversation {
  id           String                    @id @default(uuid())
  participants ConversationParticipant[]
  messages     Message[]
  // isGroup=false: 1-1 (nhu tu truoc gio, luon dung 2 participants). isGroup=true:
  // nhom (>= 3 participants) - name bat buoc, avatarColor la 1 trong so mau
  // co dinh nguoi tao chon luc tao (CHUA co upload anh that, xem
  // CreateGroupModal.tsx o frontend), luu lai co dinh CHO NHOM DO chu khong
  // phai random moi lan render.
  isGroup      Boolean                   @default(false)
  name         String?
  avatarColor  String?
  // Chi nhom dung - "Mo ta" trong panel thong tin nhom (GroupInfoPanel.tsx).
  description  String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

// lastReadAt: moc "da doc den dau" cua TUNG nguoi trong hoi thoai - unreadCount
// tinh bang dem Message.createdAt > lastReadAt (null = chua doc gi, tat ca
// deu tinh la chua doc). isFavorite/isMuted/isRestricted la cai dat RIENG
// cua TUNG nguoi ve hoi thoai nay (khong doi xung - toi tat thong bao khong
// lam nguoi kia bi tat theo), nen nam tren participant row chu khong phai
// Conversation.
model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  isFavorite     Boolean      @default(false)
  isMuted        Boolean      @default(false)
  // "Han che" o pham vi MVP = tat thong bao/toast + hien mo trong danh sach,
  // KHONG lam day du co che "hop thu yeu cau an" cua Instagram (doi hoi
  // hang doi rieng, nguoi bi han che khong biet - ngoai pham vi yeu cau).
  isRestricted   Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

// TEXT: content bat buoc (nhu cu). Cac loai con lai: content la caption
// TUY CHON, du lieu chinh nam o attachment* (IMAGE/FILE/VOICE/GIF) hoac
// quan he `poll` (POLL) - xem ChatService.sendMessage.
enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  GIF
  POLL
  // Tin he thong (vd "X đã thêm Y vào nhóm") - senderId la NGUOI THUC HIEN
  // hanh dong (khong phai "nguoi gui" theo nghia thong thuong), content la
  // cau mo ta san. Luu that vao Message (khong phai chi 1 socket event tam
  // thoi) de xuat hien DUNG VI TRI trong lich su tin nhan, ke ca sau khi tai
  // lai trang - xem ChatService.addGroupMembers.
  SYSTEM
}

model Message {
  // ULID (khong dung uuid()) - sinh o app (ChatService.sendMessage) de id tu
  // sap xep theo thoi gian, dung lam cursor phan trang xem tin nhan cu
  // (orderBy: id thay vi createdAt - id la unique + sortable, tranh dung
  // createdAt lam cursor field vi co the trung nhau khi nhieu tin gui cung
  // luc, gay phan trang khong on dinh/lap-sot tin).
  id                 String                   @id
  conversationId     String
  conversation       Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId           String
  sender             User                     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type               MessageType              @default(TEXT)
  content            String?
  // IMAGE/FILE/VOICE/GIF dung chung 4 field nay - upload that di qua
  // UploadService (AWS S3), xem uploads.module.ts. GIF: attachmentUrl la link
  // Giphy, khong upload len S3.
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  // Chi VOICE dung - do dai ban ghi am (giay), FE hien "0:42" tren bubble.
  durationSeconds    Int?
  poll               Poll?
  // Reply/quote - tro toi 1 Message KHAC trong CUNG hoi thoai (khong validate
  // o schema, ChatService tu kiem tra). SetNull khi tin goc bi xoa/thu hoi de
  // khong lam vo chuoi reply (con lai la "tin nhan da bi xoa" o phia FE dua
  // vao replyTo null + replyToId con gia tri... thuc te KHONG xoa cung Message
  // - xem isRecalled, nen truong hop SetNull hiem xay ra tren thuc te).
  replyToId          String?
  replyTo            Message?                 @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies            Message[]                @relation("MessageReplies")
  // Thu hoi (unsend) - CHI nguoi gui thu hoi duoc tin cua chinh minh. Giu
  // nguyen row (khong xoa that) de khong pha vo thu tu/reply chain - FE hien
  // "Tin nhắn đã được thu hồi" thay vi content/attachment that.
  isRecalled         Boolean                  @default(false)
  reactions          MessageReaction[]
  // Ghim tin nhan - pinnedAt (khong chi 1 boolean) de sap xep "tin ghim moi
  // nhat" trong GroupInfoPanel.tsx (preview chi hien 1 tin gan nhat).
  isPinned           Boolean                  @default(false)
  pinnedAt           DateTime?
  createdAt          DateTime                 @default(now())
  // Cot GENERATED (STORED) o DB - Postgres tu tinh lai moi khi `content` doi,
  // KHONG ghi tu Prisma (Unsupported = Prisma bo qua field nay khi build
  // query thuong, chi truy van duoc qua $queryRaw). Xem migration
  // "message_search_vector" de biet bieu thuc sinh gia tri (to_tsvector
  // config "simple" + unaccent) va docs/chat-search-architecture.md de biet
  // ly do chon huong nay.
  // Cot GENERATED (STORED) o DB - Postgres tu tinh lai moi khi `content` doi,
  // KHONG ghi tu Prisma (Unsupported = Prisma bo qua field nay khi build
  // query thuong, chi truy van duoc qua $queryRaw). Xem migration
  // "message_search_vector" de biet bieu thuc sinh gia tri (to_tsvector
  // config "simple" + unaccent) va docs/chat-search-architecture.md de biet
  // ly do chon huong nay.
  searchVector       Unsupported("tsvector")?

  @@index([conversationId, createdAt])
  // Ho tro cursor pagination trong listMessages (orderBy: id, cursor: { id }).
  @@index([conversationId, id])
}

// 1 nguoi CHI co toi da 1 reaction/tin nhan (giong Messenger/Zalo, khong
// phai kieu Discord nhieu emoji chong nhau) - doi emoji = ghi de (upsert),
// khong tao them dong moi.
model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

// 1-1 voi Message (type = POLL) - cau hoi + danh sach option, KHONG cho sua
// sau khi tao (giong tin nhan thuong).
model Poll {
  id        String       @id @default(uuid())
  messageId String       @unique
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  question  String
  options   PollOption[]
  createdAt DateTime     @default(now())
}

model PollOption {
  id     String     @id @default(uuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  votes  PollVote[]

  @@index([pollId])
}

// Luon single-choice cho MVP (khong co allowMultiple) - PollService dam bao
// 1 nguoi chi co toi da 1 vote CON SONG trong toan bo poll (xoa vote cu truoc
// khi tao vote moi neu doi lua chon), @@unique chi de chan double-click tren
// CUNG 1 option.
model PollVote {
  id           String     @id @default(uuid())
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([pollOptionId, userId])
  @@index([userId])
}

// GL Life Book (/services/gl-life-book) - "tap chi" lat trang, moi trang la 1
// luoi 10x14 o VO HINH chua cac Block tu do keo/resize. `userId` la STRING
// THUONG (KHONG phai FK toi User) - Phase 1 CHUA co auth that cho tinh nang
// nay (hardcode "demo-user" o BooksController), gan FK vao 1 User.id khong
// ton tai se vi pham rang buoc khoa ngoai. Se doi thanh FK that + @CurrentUserId()
// khi noi tinh nang nay voi auth that o phase sau.
model Book {
  id          String   @id @default(uuid())
  userId      String
  title       String
  // Cau hinh trang bia (mau/anh/font...) - tu do theo Phase sau, chua co
  // schema co dinh nen la Json giong Document.content.
  coverConfig Json?
  // Cong tac "mo cua" cho route /services/gl-life-book/[bookId] - mac dinh
  // false (dong) vi editor con dang xay dang do (Phase 6) va toan bo
  // BooksController dang @Public() khong auth. KHONG expose field nay qua
  // UpdateBookDto - de 1 endpoint PATCH cong khai bat lai duoc se vo hieu
  // hoa chinh muc dich dong cua no; chi doi qua migration/script rieng.
  isOpen      Boolean  @default(false)
  pages       Page[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// 1 trang trong Book - `order` 0 = trang muc luc (Table of Contents, luon
// rong o Phase 1), cac trang sau la noi dung THAT (luoi 10x14 chua Block).
model Page {
  id        String   @id @default(uuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order     Int
  blocks    Block[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, order])
  @@index([bookId])
}

// 1 khoi tren luoi 10x14 (vo hinh) cua 1 Page - gridX/gridY la o BAT DAU
// (0-based), gridW/gridH la so cot/hang khoi chiem (mac dinh 2x2). `content`
// la Konva scene JSON (stage.toJSON() tu react-konva editor, xem Phase 3) -
// null = block con rong (chua mo editor lan nao) - de Json giong cach
// Document.content (Tiptap JSON) dang lam, KHONG rang buoc schema cu the vi
// hinh dang Konva scene nam ngoai kiem soat cua BE.
model Block {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  gridX     Int
  gridY     Int
  gridW     Int      @default(2)
  gridH     Int      @default(2)
  content   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

// GL Daily Diary - "chu de" nguoi dung (chi 1 admin duy nhat, xem User.isAdmin)
// tu tao/sua/xoa, moi topic chua nhieu DiaryEntry hien thi dang slide cuon
// ngang o FE (xem DiaryShell.tsx). Khac Book/Page o tren (Book.userId la
// string demo, KHONG FK that) - o day dung FK that vi day la tinh nang dung
// that cho 1 tai khoan that, khong con o Phase demo.
model DiaryTopic {
  id         String       @id @default(uuid())
  ownerId    String
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int          @default(0)
  entries    DiaryEntry[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([ownerId, orderIndex])
}

model DiaryEntry {
  id        String     @id @default(uuid())
  topicId   String
  topic     DiaryTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  content   String
  // Ngay NGUOI DUNG chon cho bai viet (co the khac ngay tao that, vd viet bu
  // cho hom qua) - @db.Date vi chi can ngay, khong can gio/timezone.
  entryDate DateTime   @db.Date
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([topicId, entryDate])
}

// ============================================================================
// KHOI PHUC 2026-09-08: 18 model duoi day co THAT tren DB (Category, Article,
// Collection, Tag, Goal, RoadmapNode...) nhung bi THIEU hoan toan khoi
// schema.prisma cua repo nay (khong ro tu bao gio/vi sao lech) - phat hien
// khi chay migrate cho Compose Giai doan 2 (them Post.visibility), Prisma
// doi RESET ca database vi khong nhan ra cac bang nay. Da xac nhan voi nguoi
// dung: cac model nay THUOC VE du an, dua lai vao day qua `prisma db pull`
// (doc-only, khong doi du lieu) roi doi ten field quan he ve dung quy uoc
// camelCase cua repo (introspection tu dat ten PascalCase kieu ArticleTag
// ArticleTag[] - KHONG co code nao trong repo dang dung ten cu nay nen doi
// thoai mai, an toan). CHUA co service/controller/DTO nao trong src/ dung
// toi cac model nay - phan backend cho tinh nang Article/Roadmap/Goal (neu
// co) van con thieu, chi moi khoi phuc duoc schema.
// ============================================================================

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HighlightColor {
  YELLOW
  GREEN
  BLUE
  PINK
}

enum QuestionStatus {
  OPEN
  ANSWERED
}

enum RoadmapNodeKind {
  MILESTONE
  TOPIC
}

enum RoadmapNodeStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model Category {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  description String?
  icon        String?
  orderIndex  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  collections Collection[]
}

model Collection {
  id            String        @id @default(uuid())
  categoryId    String
  userId        String
  slug          String
  title         String
  description   String?
  coverImageUrl String?
  status        ContentStatus @default(DRAFT)
  orderIndex    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  articles      Article[]

  @@unique([categoryId, slug])
  @@index([categoryId, orderIndex])
}

model Article {
  id                  String               @id @default(uuid())
  collectionId        String
  userId              String
  slug                String
  title               String
  excerpt             String?
  content             Json
  coverImageUrl       String?
  status              ContentStatus        @default(DRAFT)
  orderIndex          Int                  @default(0)
  readingTimeSec      Int?
  viewCount           Int                  @default(0)
  publishedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  collection          Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  bookmarks           ArticleBookmark[]
  comments            ArticleComment[]
  likes               ArticleLike[]
  tags                ArticleTag[]
  highlights          Highlight[]
  questions           Question[]
  roadmapNodeArticles RoadmapNodeArticle[]

  @@unique([collectionId, slug])
  @@index([collectionId, orderIndex])
  @@index([status, publishedAt])
}

model ArticleBookmark {
  id        String   @id @default(uuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
}

model ArticleComment {
  id        String                   @id @default(uuid())
  articleId String
  userId    String
  parentId  String?
  content   String
  isDeleted Boolean                  @default(false)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  article   Article                  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent    ArticleComment?          @relation("ArticleCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ArticleComment[]         @relation("ArticleCommentReplies")
  reactions ArticleCommentReaction[]

  @@index([articleId, createdAt])
  @@index([parentId])
}

model ArticleCommentReaction {
  id        String         @id @default(uuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime       @default(now())
  comment   ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
}

model ArticleLike {
  id        String   @id @default(uuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
}

model Tag {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  articleTags ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Highlight {
  id         String         @id @default(uuid())
  articleId  String
  userId     String
  exactText  String
  prefixText String
  suffixText String
  color      HighlightColor @default(YELLOW)
  note       String?
  createdAt  DateTime       @default(now())
  article    Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, userId])
}

model Goal {
  id           String        @id @default(uuid())
  userId       String
  slug         String
  title        String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  roadmapNodes RoadmapNode[]

  @@unique([userId, slug])
  @@index([userId])
}

model RoadmapNode {
  id          String                @id @default(uuid())
  goalId      String
  parentId    String?
  title       String
  description String?
  kind        RoadmapNodeKind       @default(TOPIC)
  orderIndex  Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  goal        Goal                  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  parent      RoadmapNode?          @relation("RoadmapNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    RoadmapNode[]         @relation("RoadmapNodeChildren")
  questions   Question[]
  articles    RoadmapNodeArticle[]
  progress    RoadmapNodeProgress[]

  @@index([goalId, parentId, orderIndex])
}

model RoadmapNodeArticle {
  nodeId     String
  articleId  String
  note       String?
  orderIndex Int         @default(0)
  article    Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  node       RoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([nodeId, articleId])
  @@index([articleId])
}

model RoadmapNodeProgress {
  id          String            @id @default(uuid())
  nodeId      String
  userId      String
  status      RoadmapNodeStatus @default(NOT_STARTED)
  completedAt DateTime?
  updatedAt   DateTime          @updatedAt
  node        RoadmapNode       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, userId])
}

model Question {
  id            String           @id @default(uuid())
  userId        String
  content       String
  articleId     String?
  roadmapNodeId String?
  status        QuestionStatus   @default(OPEN)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  article       Article?         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  roadmapNode   RoadmapNode?     @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)
  answers       QuestionAnswer[]

  @@index([articleId])
  @@index([roadmapNodeId])
  @@index([userId])
}

model QuestionAnswer {
  id         String   @id @default(uuid())
  questionId String
  content    String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ============================================================================
// TRACKING (2026-09-09) - khu vuc lap ke hoach + nang luong ca nhan, 7 module
// (Goal Compass/Weekly Planner/Daily Command Center/Energy Tracker/
// Accountability Hub/Wellness Engine/Analytics). Moi userId o day la CHU SO
// HUU DUY NHAT xem duoc (khong can AdminGuard/ownership-check phuc tap nhu
// Diary) - TRU TrackingGroup/TrackingGroupSession can check thanh vien truoc
// khi cho xem, xem tracking/accountability/*.
// ============================================================================

enum TrackingTimeBlockKind {
  FOCUSED
  GENERAL
  LIFE
  BUFFER
}

enum TrackingSkipReason {
  AVOIDANCE
  OUT_OF_TIME
  INTERRUPTED
  MISESTIMATED
}

model TrackingGoal {
  id                    String              @id @default(uuid())
  userId                String
  title                 String
  // Tu do (vd "Học tập"/"Sức khoẻ"/"Kỹ năng mềm") - khong phai enum co dinh,
  // khac PostCategory (Tracking la khong gian rieng, khong dung chung
  // taxonomy Knowledge World cua Post).
  category              String
  startDate             DateTime?           @db.Date
  targetDate            DateTime?           @db.Date
  // Priority Matrix 2x2 (Quan trong x Kiem soat duoc) - 2 truc doc lap.
  important             Boolean             @default(true)
  controllable          Boolean             @default(true)
  // Flow "day du" - Vi sao muc tieu nay quan trong (Define stage) + gio du
  // kien/tuan (dung cho Reality Check, xem TrackingSettings).
  why                   String?
  estimatedHoursPerWeek Float?
  milestones            TrackingMilestone[]
  steps                 TrackingGoalStep[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, targetDate])
}

// Tang giua Goal va Action (TrackingGoalStep) - "De dat muc tieu nay, nhung
// moc nao can hoan thanh?" (Decompose stage). Step CU (tao truoc khi co
// tang nay) van goalId truc tiep, milestoneId null - xem TrackingGoalStep.
model TrackingMilestone {
  id             String             @id @default(uuid())
  goalId         String
  goal           TrackingGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title          String
  orderIndex     Int                @default(0)
  createdAt      DateTime           @default(now())
  weeklyGoalNote String?
  steps          TrackingGoalStep[]

  @@index([goalId, orderIndex])
}

model TrackingGoalStep {
  id               String             @id @default(uuid())
  goalId           String
  goal             TrackingGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  // Null = step "cu" truoc khi co Milestone (tuong thich nguoc), hoac step
  // nguoi dung co tinh khong gan milestone nao.
  milestoneId      String?
  milestone        TrackingMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title            String
  dueDate          DateTime?          @db.Date
  done             Boolean            @default(false)
  orderIndex       Int                @default(0)
  // Dung cho Reality Check (tong gio can vs gio co that) - xem
  // TrackingSettings/tracking-goal.service.ts.
  estimatedMinutes Int?

  @@index([goalId, orderIndex])
  @@index([milestoneId, orderIndex])
}

// Reality Check - "gio ranh/tuan" nguoi dung tu khai bao, so voi tong gio
// can cua moi TrackingGoalStep chua xong. 1 dong/user (khong can lich su).
model TrackingSettings {
  userId               String @id
  weeklyAvailableHours Float  @default(20)
}

model TrackingTimeBlock {
  id          String                @id @default(uuid())
  userId      String
  date        DateTime              @db.Date
  // Phut tinh tu 00:00 (vd 9:30 = 570) - don gian hoa luu tru/so sanh so voi
  // luu DateTime day du cho 1 gio-trong-ngay.
  startMinute Int
  endMinute   Int
  label       String
  kind        TrackingTimeBlockKind @default(GENERAL)
  goalStepId  String?

  @@index([userId, date])
}

model TrackingTask {
  id               String              @id @default(uuid())
  userId           String
  date             DateTime            @db.Date
  title            String
  timeBlockId      String?
  estimatedMinutes Int?
  done             Boolean             @default(false)
  // "Non-Negotiable Pin" - MVP chi la nhan/vien do, CHUA co modal chan cung
  // ep chia nho (xem plan "Khong lam lan nay").
  pinned           Boolean             @default(false)
  skipReason       TrackingSkipReason?
  reviewNote       String?
  createdAt        DateTime            @default(now())
  // So lan da "Doi sang mai" - Vong Ngay: khi >=2 (sang ngay thu 3), hero
  // card o DailyCommandCenterShell.tsx chuyen sang khung "rescue" goi y buoc
  // khoi dong nho hon thay vi ep lam het task goc.
  postponedCount   Int                 @default(0)

  @@index([userId, date])
}

model TrackingEnergyCheckin {
  id        String   @id @default(uuid())
  userId    String
  checkedAt DateTime @default(now())
  // Ca 3 truc 1-5, khong validate range o DB (validate o DTO backend).
  physical  Int
  emotional Int
  mental    Int

  @@index([userId, checkedAt])
}

model TrackingWellnessLog {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @db.Date
  sleepHours      Float?
  sleepQuality    Int?
  napMinutes      Int?
  exerciseMinutes Int?
  mealsLogged     Int      @default(0)
  notes           String?

  // 1 log/ngay/user - PUT tracking/wellness/:date la upsert dua vao unique nay.
  @@unique([userId, date])
}

model TrackingGroup {
  id          String                 @id @default(uuid())
  name        String
  createdById String
  // Ma moi cong khai (khong phai token bi mat cao) - chia se link
  // /tracking/accountability?join=<code>, don gian hon he thong invite rieng.
  inviteCode  String                 @unique @default(uuid())
  members     TrackingGroupMember[]
  sessions    TrackingGroupSession[]
  createdAt   DateTime               @default(now())
}

model TrackingGroupMember {
  groupId  String
  group    TrackingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  joinedAt DateTime      @default(now())

  @@id([groupId, userId])
}

model TrackingGroupSession {
  id        String        @id @default(uuid())
  groupId   String
  group     TrackingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  goalText  String
  completed Boolean       @default(false)
  startedAt DateTime      @default(now())
  endedAt   DateTime?

  @@index([groupId, startedAt])
}

// "Series" dang chuoi bai/khoa hoc nhieu phan (vd 1 bo skill, 1 tutorial
// nhieu chuong) - hien o /series (enggo), sidebar rieng + trang tong quan +
// trang tung Entry. Dat ten "ContentSeries*" (KHONG dung "Series" tran) vi
// LUC TAO da co model DocumentSeries + SeriesModule (src/series/**) trung
// ten, phuc vu tinh nang gom Document CUNG CHU DE trong 1 KnowledgeGroup -
// hoan toan khac chuc nang. 2 cai do da bi xoa cung tinh nang Workspace/
// KnowledgeGroup (2026-09-14), nhung GIU NGUYEN ten "ContentSeries*" o day
// (khong doi lai "Series" tran) - doi ten se keo theo sua lai toan bo
// src/content-series/**, enggo/src/**/series/** ma khong doi hanh vi gi.
//
// stats/installTabs/externalLinks la Json (khong tach bang rieng) vi day la
// du lieu hien thi TU DO, so luong nho, luon fetch cung luc voi Series, va
// khong can loc/join theo tung phan tu - tach bang se chi them JOIN vo ich.
// Category/Entry la bang that vi can @@unique de dam bao slug/orderIndex
// duy nhat (rang buoc #6 trong dac ta) va can query rieng (vd liet ke entry
// theo category cho sidebar nav).
model ContentSeries {
  id                     String                  @id @default(uuid())
  slug                   String                  @unique
  title                  String
  description            String
  authorName             String
  authorAvatarUrl        String?
  // Anh nen hero cho trang tong quan 1 Series (/series/[slug]) - DA MO RONG
  // (2026-09-15) sang dung CHUNG lam anh cho the "campaign card" o
  // /home + /series (yeu cau nguoi dung: redesign the Series thanh dang
  // banner co anh/badge/CTA, xem SeriesCampaignCard.tsx) - truoc day 2 noi
  // do co chu dich giu phang/khong anh, nay doi huong nguoc lai theo yeu cau
  // moi, sieu ro rang trong 1 lan yeu cau chi tiet.
  coverImageUrl          String?
  emailCourseEnabled     Boolean                 @default(false)
  emailCourseTitle       String?
  emailCourseDescription String?
  // [{label, value, icon?, link?}]
  stats                  Json                    @default("[]")
  // [{label, command, note?, link?}] - dung chung cho Install Widget o
  // Overview; tung Entry co the ghi de qua ContentSeriesEntry.installTabs.
  installTabs            Json                    @default("[]")
  // [{label, url, icon?}]
  externalLinks          Json                    @default("[]")
  // Danh sach kenh chia se bat, vd ["x","bluesky","linkedin","copy"].
  shareChannels          String[]                @default(["x", "bluesky", "linkedin", "copy"])
  // --- The "campaign card" hien thi o /home (rail) + /series (list) - xem
  // SeriesCampaignCard.tsx + tab "Thẻ hiển thị" trong SeriesManageTabs.tsx.
  // orderIndex CHI dung de admin drag-reorder trang /series (KHONG anh
  // huong thu tu "Series mới nhất" o /home, van dua vao createdAt desc,
  // xem findAll()).
  orderIndex             Int                     @default(0)
  badgeText              String?
  // info | success | warning | deadline | custom
  badgeVariant           String                  @default("info")
  // Dung khi badgeVariant = "custom".
  badgeColor             String?
  badgeTextColor         String?
  // Hien thi dang "còn N ngày"/"Đã kết thúc" TAI THOI DIEM RENDER - KHONG co
  // job/cron nao tu doi trang thai theo gio nay (nam ngoai pham vi yeu cau).
  deadlineAt             DateTime?
  // left | right
  imagePosition          String                  @default("left")
  imageWidthPercent      Int                     @default(45)
  // cover | contain
  imageFit               String                  @default("cover")
  // null = dung nen surface mac dinh cua the.
  backgroundColor        String?
  // dark | light - quyet dinh mau chu tren backgroundColor.
  textTheme              String                  @default("dark")
  // default | soft | accent
  cardStyle              String                  @default("default")
  // [{id, label, url, style: primary|secondary|text, openInNewTab}]
  actions                Json                    @default("[]")
  showBadge              Boolean                 @default(true)
  showDeadline           Boolean                 @default(true)
  // An khoi /home + /series ma KHONG xoa - xem findAll()/findAllPublic con
  // trang tong quan/doc Entry van xem duoc binh thuong qua URL truc tiep.
  isVisible              Boolean                 @default(true)
  categories             ContentSeriesCategory[]
  entries                ContentSeriesEntry[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

// Nhom chu de trong 1 Series (vd "Getting Started") - ho tro nested qua
// parentId (rang buoc #3 trong dac ta: "Hỗ trợ nested category").
model ContentSeriesCategory {
  id         String                  @id @default(uuid())
  seriesId   String
  series     ContentSeries           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     ContentSeriesCategory?  @relation("ContentSeriesCategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   ContentSeriesCategory[] @relation("ContentSeriesCategoryChildren")
  slug       String
  title      String
  orderIndex Int                     @default(0)
  colorHex   String?
  entries    ContentSeriesEntry[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([seriesId, slug])
  @@index([seriesId, orderIndex])
  @@index([parentId])
}

// 1 bai/skill trong Series. `orderIndex` la thu tu HIEN THI + dung tinh
// pagination Prev/Next (rang buoc #6: thu tu duy nhat trong 1 Series).
// installTabs/faq de null = ke thua/khong co, KHAC mang rong (mang rong o
// Series.installTabs nghia la series khong bat Install Widget).
model ContentSeriesEntry {
  id              String                @id @default(uuid())
  seriesId        String
  series          ContentSeries         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  categoryId      String
  category        ContentSeriesCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug            String
  orderIndex      Int
  title           String
  // Ten hien thi RIENG trong sidebar (cay category/entry) - null = dung
  // chung `title` (mac dinh, khong bat buoc dien them). Tach khoi `title`
  // (H1 tren trang doc) vi 2 ngu canh do dai chu cho phep khac nhau: sidebar
  // hep can 1 dong ngan gon, H1 co the dai/mo ta hon - yeu cau nguoi dung
  // "tôi muốn có thể tùy chỉnh title ở 2 vị trí đó".
  navTitle        String?
  subtitle        String?
  icon            String?
  source          String?
  contentMarkdown String
  // Ghi de Install Widget rieng cho Entry nay - null = dung
  // ContentSeries.installTabs. Xem comment tren ContentSeries.installTabs.
  installTabs     Json?
  // [{question, answer}] - null/rong = khong hien FAQ section.
  faq             Json?
  // Danh sach "khoi noi dung" hien THE TREN CUNG bai (truoc than bai markdown) -
  // yeu cau nguoi dung: "chia làm nửa trên... custom thêm đa dạng các
  // element... sắp xếp thứ tự hiển thị". Moi phan tu: {id, type: "toc" |
  // "install" | "buttonGroup" | "callout", ...config theo type} - THU TU
  // TRONG MANG = thu tu hien thi (khong co orderIndex rieng, giong pattern
  // ContentSeries.actions). null/rong = fallback ve hanh vi CU (1 box TOC H2
  // tu dong, xem SeriesEntryContentBlocks.tsx) - entry cu KHONG can migrate
  // du lieu.
  contentBlocks   Json?
  readTimeMinutes Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([seriesId, slug])
  @@unique([seriesId, orderIndex])
  @@index([seriesId, orderIndex])
  @@index([categoryId])
}
