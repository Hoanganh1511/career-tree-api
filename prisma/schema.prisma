// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ShareMode {
  PRIVATE
  STRUCTURE_ONLY
  FULL
}

model Workspace {
  id            String         @id @default(uuid())
  name          String         @default("My Career Tree")
  shareToken    String?        @unique
  shareMode     ShareMode      @default(PRIVATE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  nodes         Node[]
  categories    Category[]
  crossLinks    CrossLink[]
  notifications Notification[]
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId       String?

  @@index([ownerId])
}

// Skill Tree: tang phan cap moi giua Workspace va Tier - 1 Workspace (=
// 1 "Skill Set") co nhieu Category (vd "Frontend", "Backend"), MOI Category
// co bo Tier rieng cua no (khong dung chung Tier giua cac Category).
model Category {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String? // mo ta ngan, hien trong Knowledge Block Summary
  icon        String? // slug icon (vd simple-icons/lucide), tuy chon
  color       String? // hex, dung cho khoi the Category ben trai canvas
  orderIndex  Int       @default(0)
  tiers       Tier[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

enum NotificationType {
  SYSTEM
  CONNECTION
}

model Notification {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId])
}

model Node {
  id               String      @id @default(uuid())
  workspaceId      String
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           Node?       @relation("NodeToNode", fields: [parentId], references: [id], onDelete: Cascade)
  children         Node[]      @relation("NodeToNode")
  kind             NodeKind    @default(BRANCH)
  category         String?
  difficulty       Difficulty?
  estimatedTime    String?
  prerequisites    String[]    @default([])
  learningOutcomes String[]    @default([])
  title            String
  goal             String?
  isPinned         Boolean     @default(false) //nut bookmark
  tags             String[]    @default([]) // Javascript, TypeScript, Nestjs.,...
  content          Json? // Tiptap/ProseMirror JSON — long-form notes for this node (distinct from Card, which is the quick activity log)
  depth            Int         @default(0)
  orderIndex       Int         @default(0)
  x                Float?
  y                Float?
  hiddenFromShare  Boolean     @default(false)
  isCollapsed      Boolean     @default(false)
  // Skill Tree: null = node chua gan tier (vd node cua Career Tree canvas cu),
  // gan Tier moi khi node duoc dat vao 1 vi tri tren skill tree.
  tierId           String?
  tier             Tier?       @relation(fields: [tierId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  cards            Card[]
  crossLinksFrom   CrossLink[] @relation("CrossLinkFrom")
  crossLinksTo     CrossLink[] @relation("CrossLinkTo")
  resources        Resource[]
  issues           Issue[]

  @@index([workspaceId, parentId])
  @@index([tierId])
}

// Tier thuoc ve 1 Category (khong con thuoc truc tiep Workspace) - moi
// Category co bo Tier rieng cua no.
model Tier {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label      String // "TIER 1"
  sublabel   String // "FOUNDATION"
  orderIndex Int      @default(0)
  nodes      Node[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

enum CardKind {
  NOTE
  PRACTICE
}

model Card {
  id         String   @id @default(uuid())
  nodeId     String
  node       Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  content    Json //Tiptap/ProseMirror JSON
  kind       CardKind @default(NOTE)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([nodeId])
}

enum ResourceType {
  ARTICLE
  VIDEO
  DOC
  COURSE
  BOOK
}

enum NodeKind {
  BRANCH
  TOPIC
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Resource {
  id         String       @id @default(uuid())
  nodeId     String
  node       Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  type       ResourceType
  title      String
  url        String
  orderIndex Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([nodeId])
}

model Issue {
  id        String   @id @default(uuid())
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  question  String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nodeId])
}

model CrossLink {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromNodeId  String
  fromNode    Node      @relation("CrossLinkFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId    String?
  toNode      Node?     @relation("CrossLinkTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  label       String?
  createdAt   DateTime  @default(now())

  @@unique([fromNodeId, toNodeId])
}

model User {
  id                String       @id @default(uuid())
  googleId          String       @unique
  email             String       @unique
  name              String
  // Dashboard Skill Tree: dung de so sanh benchmark theo nam kinh nghiem
  // (Phase 4) - de null neu nguoi dung chua khai bao.
  yearsOfExperience Int?
  // "Dang xuat khoi moi thiet bi": moi token noi bo co `iat` TRUOC moc nay
  // deu bi tu choi (xem JwtAuthGuard). Session cua Auth.js la JWT stateless
  // (khong co session store) nen day la cach duy nhat thu hoi duoc session
  // ma khong phai doi ca co che session - xem docs/user-schema-design.md.
  tokensValidAfter  DateTime?
  // Danh tinh cong khai cho feed (Post.author) - xem docs/user-schema-design.md
  // muc 4.1/4.2 (Phase 1). Nullable vi user dong bo qua Google sync KHONG co
  // san 3 field nay (Google chi cho googleId/email/name/picture) - UserService
  // tu sinh username tu email luc sync neu con null.
  username          String?      @unique
  avatarUrl         String?
  verified          Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  workspaces        Workspace[]
  posts             Post[]
  followerCount     Int          @default(0)
  followingCount    Int          @default(0)
  following         UserFollow[] @relation("Follower")
  followedBy        UserFollow[] @relation("Followee")
  blocksMade        UserBlock[]  @relation("Blocker")
  blockedBy         UserBlock[]  @relation("Blocked")
  profile           UserProfile?

  communitiesOwened    Community[]
  communityMemberships CommunityMember[]
  communityPosts       CommunityPost[]
  comments             Comment[]
  reactions            Reaction[]
}

model SystemFlag {
  id                 Int     @id @default(1)
  legacyBackfillDone Boolean @default(false)
}

// Feed Trang chu - truoc day 100% mock o frontend (enggo/src/content/
// home-feed-mock.ts), gio la du lieu that. 1 bang CHUNG cho ca 24 "kind" bai
// dang (dung 1 bang + cot `data: Json` chua field rieng tung loai, giong cach
// Card.content dang lam cho Node) thay vi 24 bang/cot rieng - tranh no schema.
// `kind` luu SCREAMING_SNAKE (dung convention enum cua repo); API tra ve/nhan
// vao dang kebab-case ("skill-report") khop voi frontend Post["kind"] union -
// chuyen doi 2 chieu nam trong post.service.ts (PostModule), KHONG trong DTO.
enum PostKind {
  TEXT
  IMAGE
  GALLERY
  VIDEO
  FILE
  LINK
  RESOURCE
  NOTE
  PROJECT_UPDATE
  ACHIEVEMENT
  MILESTONE
  QUESTION
  POLL
  CAREER_UPDATE
  SKILL_UPDATE
  NODE_CREATED
  KNOWLEDGE_BLOCK
  TIMELINE_EVENT
  CODE_SNIPPET
  IDEA
  TUTORIAL
  EXPERIMENT
  EVENT
  SKILL_REPORT
}

enum FollowStatus {
  ACTIVE
  PENDING
}

// "Topic" cua bai dang (vd Frontend/Backend/LLM/...) - khop 1-1 voi danh sach
// topic trong enggo/src/lib/discover/knowledge-worlds.ts (slug kebab-case ben
// frontend -> UPPER_SNAKE_CASE o day, vd "ai-agents" -> AI_AGENTS). Day la
// TANG LOC DUOC (co index), khac "topic" trong `data` JSON (tu do, chi de
// hien thi breadcrumb, khong index duoc - ten trung nhau nhung 2 khai niem
// khac nhau).
//
// GAME_DEV/IOT/DEV_TOOLS/DATA_AI/UI_UX/CAREER/SOFT_SKILLS/QA_TEST/SECURITY la
// gia tri CU tu taxonomy nghe nghiep truoc day (category-taxonomy.ts, da xoa)
// - GIU LAI vi da co bai seed gan gia tri nay, khong con duoc UI moi
// (knowledge-worlds.ts) su dung de tao pill/topic nua.
enum PostCategory {
  FRONTEND
  BACKEND
  MOBILE
  GAME_DEV
  BLOCKCHAIN
  IOT
  DEV_TOOLS
  DATA_AI
  DATABASE
  PRODUCT
  UI_UX
  DEVOPS
  CLOUD
  SYSTEM_DESIGN
  SECURITY
  QA_TEST
  CAREER
  SOFT_SKILLS
  // --- Them cho Knowledge World "Think" ---
  ALGORITHMS
  ARCHITECTURE
  PERFORMANCE
  DISTRIBUTED_SYSTEMS
  // --- Them cho Knowledge World "AI" ---
  PROMPT_ENGINEERING
  LLM
  AI_AGENTS
  MCP
  RAG
  COMPUTER_VISION
  // --- Them cho Knowledge World "Create" ---
  UI
  UX
  MOTION
  FIGMA
  DESIGN_SYSTEM
  // --- Them cho Knowledge World "Career" (topic con, khac CAREER cu o tren) ---
  RESUME
  INTERVIEW
  PRODUCTIVITY
  REMOTE
  FREELANCE
  // --- Them cho Knowledge World "Business" ---
  STARTUP
  GROWTH
  MARKETING
}

// Phan loai bai dang theo LINH VUC NGHE NGHIEP - 2 tang (nhom cha -> nhanh
// con), KHAC HAN 2 thu de nham ten:
// - `Category` (o tren): category cua Skill Tree, gan workspaceId, chua Tier.
// - `PostCategory` (enum): truc "topic" cua Knowledge Worlds (FRONTEND/LLM/...).
// 1 post co the mang CA HAI phan loai (vd topic=PERFORMANCE +
// nghe nghiep="Lap trinh web/mobile") nen phai la 2 cot rieng, khong gop.
//
// Danh sach nhom/nhanh dinh nghia san qua seed (prisma/seed-posts.ts), user
// KHONG tu tao duoc.
model CareerCategoryGroup {
  id         String           @id @default(uuid())
  slug       String           @unique
  name       String
  icon       String? // slug lucide, tuy chon
  // CHI dung lam tie-breaker khi 2 nhom bang nhau ve so post 7 ngay - thu tu
  // hien thi that do so post quyet dinh (xem FeedCategoryService).
  orderIndex Int              @default(0)
  categories CareerCategory[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model CareerCategory {
  id         String              @id @default(uuid())
  groupId    String
  group      CareerCategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slug       String              @unique
  name       String
  orderIndex Int                 @default(0)
  posts      Post[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([groupId])
}

// CONTEST = cuoc thi co giai thuong/han chot; TOPIC = chu de viet bai thuong
// truc (khong giai). Ca 2 deu hien thi duoi dang 1 hashtag.
enum ContestKind {
  CONTEST
  TOPIC
}

enum ContestStatus {
  OPEN
  JUDGING
  CLOSED
}

model Contest {
  id            String        @id @default(uuid())
  slug          String        @unique
  hashtag       String        @unique // luu KHONG kem dau #, UI tu them
  title         String
  description   String
  kind          ContestKind
  status        ContestStatus @default(OPEN)
  partnerName   String? // "Asahi Beverages" -> UI hien "voi ..."
  coverImageUrl String?
  accent        String? // hex cho vien the + nen anh bia
  prize         String?
  deadline      DateTime?
  // So tinh san, cung loi voi Post.likesCount - seed cap nhat cho khop so
  // ban ghi PostContest that.
  postCount     Int           @default(0)
  posts         PostContest[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

// Bang noi tuong minh (dung convention nhu UserFollow/UserBlock) - 1 bai co
// the tham gia nhieu contest/chu de cung luc.
model PostContest {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  contestId String
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, contestId])
  @@index([contestId, createdAt])
}

model UserBlock {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockerId])
}

model UserFollow {
  followerId String
  follower   User         @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User         @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  status     FollowStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId, createdAt])
  @@index([followerId, createdAt])
}

model Post {
  id               String          @id @default(uuid())
  authorId         String
  author           User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind             PostKind
  // Linh vuc bai dang thuoc ve (Frontend/Backend/...) - optional vi khong
  // phai kind nao cung can gan (vd poll/idea co the khong chon). Day la cot
  // that, co index, dung de loc o GET /posts?category=... (xem
  // PostController) - KHAC "topic" (van nam trong `data` JSON ben duoi, chi
  // de hien thi, khong dung de loc).
  category         PostCategory?
  // Linh vuc NGHE NGHIEP cua bai (2 tang, xem CareerCategoryGroup) - truc loc
  // DOC LAP voi `category` o tren: `category` la topic Knowledge World, cot
  // nay la nganh nghe. Null = bai "Chia se chung" (khong gan nganh cu the).
  careerCategoryId String?
  careerCategory   CareerCategory? @relation(fields: [careerCategoryId], references: [id], onDelete: SetNull)
  // Field rieng tung kind (content/title/image/poll options/...) - shape khop
  // voi tung nhanh cua Post union o frontend, TRU cac field icon/accent rieng
  // le (achievement/project-update/knowledge-block/tutorial/link/resource) -
  // nhung field do gio lay theo KIND tu POST_KIND_META o frontend thay vi luu
  // rieng tung post, tranh phai serialize component icon (khong the luu DB).
  data             Json
  // So tinh, seed san - CHUA co bang Like/Comment that, bam Like/Comment o UI
  // hien la tuong tac cuc bo (xem ActionButton.tsx), chua ghi lai DB.
  likesCount       Int             @default(0)
  commentsCount    Int             @default(0)
  repostsCount     Int             @default(0)
  contests         PostContest[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([category, createdAt])
  @@index([careerCategoryId, createdAt])
}

model UserProfile {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String?
  coverImageUrl String?
  location      String?
  websiteUrl    String?
  pronouns      String?
  postCount     Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Community {
  id          String            @id @default(uuid())
  slug        String            @unique
  name        String
  description String
  isPublic    Boolean           @default(true)
  memberCount Int               @default(0) //cache, cap nhat khi CommunityMember.status -> APPROVED
  ownerId     String?
  owner       User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  channels    Channel[]
  members     CommunityMember[]
  posts       CommunityPost[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum ChannelGroup {
  KNOWLEDGE
  TOOLS
}

model Channel {
  id             String          @id @default(uuid())
  communityId    String
  community      Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  group          ChannelGroup    @default(KNOWLEDGE)
  description    String
  bannerImageUrl String?
  messageCount   Int             @default(0) //cache
  orderIndex     Int             @default(0)
  posts          CommunityPost[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([communityId, slug])
  @@index([communityId])
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  MENTOR
  MEMBER
}

enum CommunityMemberStatus {
  PENDING
  APPROVED
  REJECTED
}

model CommunityMember {
  id          String                @id @default(uuid())
  communityId String
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CommunityMemberRole   @default(MEMBER)
  status      CommunityMemberStatus @default(PENDING)
  points      Int                   @default(0) // diem hoat dong, hien "X diem" o activeMembers
  joinReason  String? // ly do xin tham gia, ung voi CommunityJoinRequestDetailed.reason
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([communityId, userId])
  @@index([communityId, status])
  @@index([userId])
}

enum CommunityPostCategory {
  LEARNING
  QUESTION
  RESOURCE
}

model CommunityPost {
  id            String                 @id @default(uuid())
  communityId   String
  community     Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  channelId     String
  channel       Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      CommunityPostCategory?
  title         String?
  content       String
  data          Json?
  isPinned      Boolean                @default(false)
  likesCount    Int                    @default(0)
  commentsCount Int                    @default(0)
  comments      Comment[]
  reactions     Reaction[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([channelId, createdAt])
  @@index([communityId, createdAt])
  @@index([authorId])
}

model Comment {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?      @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentToComment")
  content   String
  reactions Reaction[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model Reaction {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  postId    String?
  post      CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, postId, emoji])
  @@unique([userId, commentId, emoji])
  @@index([postId])
  @@index([commentId])
}
